{
  "name": "congo-ai-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "setup:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/start-windows.ps1",
    "stop:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-windows.ps1",
    "dev:web": "npm run dev --workspace @congo-ai-studio/web",
    "dev:api": "npm run start:dev --workspace @congo-ai-studio/api",
    "build:web": "npm run build --workspace @congo-ai-studio/web",
    "build:api": "npm run build --workspace @congo-ai-studio/api",
    "typecheck:web": "npm run typecheck --workspace @congo-ai-studio/web",
    "typecheck:api": "npm run typecheck --workspace @congo-ai-studio/api",
    "db:generate": "npm run db:generate --workspace @congo-ai-studio/api",
    "db:validate": "npm run db:validate --workspace @congo-ai-studio/api",
    "db:migrate": "npm run db:migrate --workspace @congo-ai-studio/api"
  },
  "engines": { "node": ">=20.11.0" }
}
